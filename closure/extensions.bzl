"""Module extension for the Closure Rules' non-module dependencies.

The jars and archives come from repositories.bzl, so WORKSPACE and Bzlmod
builds fetch the same files. The repositories that MODULE.bazel gets as
bazel_deps (protobuf, rules_java, rules_proto, skylib, ...) are omitted.

The extension also creates `@npm`, which closure_js_binary uses for its
compiler (`@npm//google-closure-compiler/bin:google-closure-compiler`). By
default it wraps the Java Closure Compiler from this extension. A root module
with its own npm `google-closure-compiler` replaces it with:

    rules_closure = use_extension(
        "@io_bazel_rules_closure//closure:extensions.bzl",
        "rules_closure_deps",
    )
    override_repo(rules_closure, "npm")

The same `override_repo` works for any other repository listed here, such as
a different `com_google_javascript_closure_library`.
"""

load("//closure:repositories.bzl", "rules_closure_dependencies")

_COMPILER_SH = """\
#!/usr/bin/env bash
# Runs the Java Closure Compiler with the flags closure_js_binary passes to the
# npm google-closure-compiler, minus the npm-only --platform.
set -euo pipefail
runfiles="${RUNFILES_DIR:-$0.runfiles}"
args=()
for arg in "$@"; do
  [[ "$arg" == --platform=* ]] || args+=("$arg")
done
exec "$runfiles/%s" "${args[@]}"
"""

def _closure_compiler_npm_impl(repository_ctx):
    compiler = repository_ctx.attr.compiler
    repository_ctx.file("BUILD.bazel", "")
    repository_ctx.file(
        "google-closure-compiler/bin/compiler.sh",
        _COMPILER_SH % (compiler.workspace_name + "/" + compiler.name),
        executable = True,
    )
    repository_ctx.file(
        "google-closure-compiler/bin/BUILD.bazel",
        """\
# Generated by @io_bazel_rules_closure//closure:extensions.bzl. Override this
# repository with override_repo to use the npm google-closure-compiler.
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

sh_binary(
    name = "google-closure-compiler",
    srcs = ["compiler.sh"],
    data = ["%s"],
    visibility = ["//visibility:public"],
)
""" % str(compiler),
    )

_closure_compiler_npm = repository_rule(
    implementation = _closure_compiler_npm_impl,
    attrs = {
        "compiler": attr.label(mandatory = True),
    },
)

def _rules_closure_deps_impl(module_ctx):
    rules_closure_dependencies(
        omit_bazel_skylib = True,
        omit_com_google_protobuf = True,
        omit_rules_cc = True,
        omit_rules_java = True,
        omit_rules_jvm_external = True,
        omit_rules_proto = True,
        omit_rules_python = True,
        omit_zlib = True,
    )
    _closure_compiler_npm(
        name = "npm",
        compiler = Label("@com_google_javascript_closure_compiler//:main"),
    )
    return module_ctx.extension_metadata(reproducible = True)

rules_closure_deps = module_extension(
    implementation = _rules_closure_deps_impl,
)
